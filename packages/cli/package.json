{
  "name": "virtari",
  "version": "0.2.0",
  "description": "Install editable Virtari design-system source into React projects.",
  "homepage": "https://github.com/itstheilya/virtari-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itstheilya/virtari-ui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/itstheilya/virtari-ui/issues"
  },
  "type": "module",
  "bin": {
    "virtari": "bin/virtari.mjs"
  },
  "files": [
    "bin",
    "skills",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node --check bin/virtari.mjs",
    "typecheck": "node --check bin/virtari.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "virtari",
    "design-system",
    "react",
    "components",
    "registry",
    "source"
  ]
}
