{
  "name": "@virtari-packages/react-code",
  "version": "0.4.0",
  "description": "Virtari code — read-only viewer, live editor, and inline snippet powered by CodeMirror 6 with token-driven theming.",
  "license": "MIT",
  "author": "Virtari",
  "homepage": "https://github.com/itstheilya/virtari-ui/tree/main/packages/react-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itstheilya/virtari-ui.git",
    "directory": "packages/react-code"
  },
  "bugs": {
    "url": "https://github.com/itstheilya/virtari-ui/issues"
  },
  "keywords": [
    "virtari",
    "design-system",
    "react",
    "ui",
    "components",
    "code",
    "code-editor",
    "syntax-highlight",
    "codemirror"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/Code.css",
    "./tokens": "./dist/Code.tokens.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup && postcss src/Code.tokens.css -o dist/Code.tokens.css && postcss src/Code.css -o dist/Code.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@virtari-packages/utils": "workspace:*",
    "@virtari-packages/react-copy-button": "workspace:*",
    "@uiw/react-codemirror": "^4.23.7",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@codemirror/language": "^6.10.6",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/search": "^6.5.8",
    "@codemirror/autocomplete": "^6.18.4",
    "@lezer/highlight": "^1.2.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/lang-xml": "^6.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^19.2.5",
    "@types/react": "^19.2.14",
    "typescript": "^5.5.0",
    "tsup": "^8.0.0"
  }
}
