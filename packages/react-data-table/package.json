{
  "name": "@virtari-packages/react-data-table",
  "version": "0.6.1",
  "description": "Virtari data table — accessible React component built on CSS variables and logical properties.",
  "license": "MIT",
  "author": "Virtari",
  "homepage": "https://github.com/itstheilya/virtari-ui/tree/main/packages/react-data-table#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itstheilya/virtari-ui.git",
    "directory": "packages/react-data-table"
  },
  "bugs": {
    "url": "https://github.com/itstheilya/virtari-ui/issues"
  },
  "keywords": [
    "virtari",
    "design-system",
    "react",
    "ui",
    "components",
    "data",
    "table"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dnd": {
      "import": {
        "types": "./dist/index.dnd.d.ts",
        "default": "./dist/index.dnd.js"
      },
      "require": {
        "types": "./dist/index.dnd.d.cts",
        "default": "./dist/index.dnd.cjs"
      }
    },
    "./styles": {
      "style": "./dist/DataTable.css",
      "default": "./dist/DataTable.css"
    },
    "./tokens": {
      "style": "./dist/DataTable.tokens.css",
      "default": "./dist/DataTable.tokens.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup && postcss src/DataTable.tokens.css -o dist/DataTable.tokens.css && postcss src/DataTable.css -o dist/DataTable.css",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/react-virtual": "^3.10.0",
    "@virtari-packages/react-avatar": "workspace:*",
    "@virtari-packages/react-badge": "workspace:*",
    "@virtari-packages/react-button": "workspace:*",
    "@virtari-packages/react-checkbox": "workspace:*",
    "@virtari-packages/react-chip": "workspace:*",
    "@virtari-packages/react-drawer": "workspace:*",
    "@virtari-packages/react-dropdown-menu": "workspace:*",
    "@virtari-packages/react-icons": "workspace:*",
    "@virtari-packages/react-input": "workspace:*",
    "@virtari-packages/react-pagination": "workspace:*",
    "@virtari-packages/react-popover": "workspace:*",
    "@virtari-packages/react-select": "workspace:*",
    "@virtari-packages/react-switch": "workspace:*",
    "@virtari-packages/react-tabs": "workspace:*",
    "@virtari-packages/utils": "workspace:*"
  },
  "peerDependencies": {
    "@tabler/icons-react": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0 || ^10.0.0",
    "@dnd-kit/utilities": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.0",
    "@tabler/icons-react": "^3.0.0",
    "react": "^19.2.5",
    "@types/react": "^19.2.14",
    "typescript": "^5.5.0",
    "tsup": "^8.0.0"
  }
}
