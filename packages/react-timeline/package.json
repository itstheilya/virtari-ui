{
  "name": "@virtari-packages/react-timeline",
  "version": "0.3.1",
  "description": "Virtari timeline — sequential event display with indicator, connector, content, and time slots.",
  "license": "MIT",
  "author": "Virtari",
  "homepage": "https://github.com/itstheilya/virtari-ui/tree/main/packages/react-timeline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itstheilya/virtari-ui.git",
    "directory": "packages/react-timeline"
  },
  "bugs": {
    "url": "https://github.com/itstheilya/virtari-ui/issues"
  },
  "keywords": [
    "virtari",
    "design-system",
    "react",
    "ui",
    "components",
    "timeline",
    "activity",
    "feed"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/Timeline.css",
    "./tokens": "./dist/Timeline.tokens.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup && postcss src/Timeline.tokens.css -o dist/Timeline.tokens.css && postcss src/Timeline.css -o dist/Timeline.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@virtari-packages/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^19.2.5",
    "@types/react": "^19.2.14",
    "typescript": "^5.5.0",
    "tsup": "^8.0.0"
  }
}
