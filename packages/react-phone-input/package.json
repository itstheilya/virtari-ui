{
  "name": "@virtari-packages/react-phone-input",
  "version": "1.0.2",
  "description": "Virtari phone input — accessible React component built on CSS variables and logical properties.",
  "license": "MIT",
  "author": "Virtari",
  "homepage": "https://github.com/itstheilya/virtari-ui/tree/main/packages/react-phone-input#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itstheilya/virtari-ui.git",
    "directory": "packages/react-phone-input"
  },
  "bugs": {
    "url": "https://github.com/itstheilya/virtari-ui/issues"
  },
  "keywords": [
    "virtari",
    "design-system",
    "react",
    "ui",
    "components",
    "phone",
    "input"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/PhoneInput.css",
    "./tokens": "./dist/PhoneInput.tokens.css"
  },
  "files": [
    "dist",
    "ATTRIBUTION.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "codegen": "node scripts/build-countries.mjs",
    "build": "pnpm codegen && tsup && postcss src/PhoneInput.tokens.css -o dist/PhoneInput.tokens.css && postcss src/PhoneInput.css -o dist/PhoneInput.css",
    "clean": "rm -rf dist src/generated",
    "typecheck": "pnpm codegen && tsc --noEmit"
  },
  "dependencies": {
    "@virtari-packages/primitives": "workspace:*",
    "@virtari-packages/react-flag": "workspace:*",
    "@virtari-packages/react-input": "workspace:*",
    "@virtari-packages/react-select": "workspace:*",
    "@virtari-packages/utils": "workspace:*",
    "libphonenumber-js": "^1.11.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "i18n-iso-countries": "^7.14.0",
    "react": "^19.2.5",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "world-countries": "^5.1.0"
  }
}
