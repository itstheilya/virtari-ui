{
  "name": "@virtari-packages/react-visually-hidden",
  "version": "1.0.1",
  "description": "Virtari visually-hidden — accessible screen-reader-only wrapper built on CSS utilities.",
  "license": "MIT",
  "author": "Virtari",
  "homepage": "https://github.com/itstheilya/virtari-ui/tree/main/packages/react-visually-hidden#readme",
  "repository": {
    "type": "git",
