{
  "name": "@virtari-packages/react-language-picker",
  "version": "0.6.1",
  "description": "Virtari language picker — accessible React component built on CSS variables and logical properties.",
  "license": "MIT",
  "author": "Virtari",
  "homepage": "https://github.com/itstheilya/virtari-ui/tree/main/packages/react-language-picker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itstheilya/virtari-ui.git",
    "directory": "packages/react-language-picker"
  },
  "bugs": {
    "url": "https://github.com/itstheilya/virtari-ui/issues"
  },
  "keywords": [
    "virtari",
    "design-system",
    "react",
    "ui",
    "components",
    "language",
    "picker"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/LanguagePicker.css",
    "./tokens": "./dist/LanguagePicker.tokens.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "codegen": "node scripts/build-languages.mjs",
    "build": "pnpm codegen && tsup && postcss src/LanguagePicker.tokens.css -o dist/LanguagePicker.tokens.css && postcss src/LanguagePicker.css -o dist/LanguagePicker.css",
    "clean": "rm -rf dist src/generated",
    "typecheck": "pnpm codegen && tsc --noEmit"
  },
  "dependencies": {
    "@virtari-packages/react-button": "workspace:*",
    "@virtari-packages/react-drawer": "workspace:*",
    "@virtari-packages/react-flag": "workspace:*",
    "@virtari-packages/react-select": "workspace:*",
    "@virtari-packages/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@cospired/i18n-iso-languages": "^4.2.0",
    "@types/react": "^19.2.14",
    "iso-639-1": "^3.1.5",
    "react": "^19.2.5",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
