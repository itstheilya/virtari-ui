{
  "name": "@virtari-packages/react-flag",
  "version": "0.3.1",
  "description": "Virtari flag — accessible React component built on CSS variables and logical properties.",
  "license": "MIT",
  "author": "Virtari",
  "homepage": "https://github.com/itstheilya/virtari-ui/tree/main/packages/react-flag#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itstheilya/virtari-ui.git",
    "directory": "packages/react-flag"
  },
  "bugs": {
    "url": "https://github.com/itstheilya/virtari-ui/issues"
  },
  "keywords": [
    "virtari",
    "design-system",
    "react",
    "ui",
    "components",
    "flag"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": {
      "style": "./dist/Flag.css",
      "default": "./dist/Flag.css"
    },
    "./tokens": {
      "style": "./dist/Flag.tokens.css",
      "default": "./dist/Flag.tokens.css"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "ATTRIBUTION.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "codegen": "node scripts/build-flags.mjs",
    "build": "pnpm codegen && tsup && postcss src/Flag.tokens.css -o dist/Flag.tokens.css && postcss src/Flag.css -o dist/Flag.css",
    "clean": "rm -rf dist src/generated",
    "typecheck": "pnpm codegen && tsc --noEmit"
  },
  "dependencies": {
    "@virtari-packages/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "flag-icons": "^7.2.3",
    "react": "^19.2.5",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
