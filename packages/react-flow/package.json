{
  "name": "@virtari-packages/react-flow",
  "version": "0.3.1",
  "description": "Virtari React Flow wrapper — token-aware surfaces, node shells, labeled edges, layout helpers, and persistence hooks for workflow builders.",
  "license": "MIT",
  "author": "Virtari",
  "homepage": "https://github.com/itstheilya/virtari-ui/tree/main/packages/react-flow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itstheilya/virtari-ui.git",
    "directory": "packages/react-flow"
  },
  "bugs": {
    "url": "https://github.com/itstheilya/virtari-ui/issues"
  },
  "keywords": [
    "virtari",
    "design-system",
    "react",
    "workflow",
    "react-flow",
    "xyflow",
    "diagram"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/ReactFlow.css",
    "./tokens": "./dist/ReactFlow.tokens.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup && postcss src/ReactFlow.tokens.css -o dist/ReactFlow.tokens.css && postcss src/ReactFlow.css -o dist/ReactFlow.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@virtari-packages/utils": "workspace:*"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.10.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@xyflow/react": "^12.10.2",
    "react": "^19.2.5",
    "typescript": "^5.5.0",
    "tsup": "^8.0.0"
  }
}
