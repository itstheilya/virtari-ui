{
  "name": "@virtari-packages/react-yoopta-editor",
  "version": "0.4.0",
  "description": "Virtari block editor - Yoopta-Editor wrapped with Virtari design tokens and primitives.",
  "license": "MIT",
  "author": "Virtari",
  "homepage": "https://github.com/itstheilya/virtari-ui/tree/main/packages/react-yoopta-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itstheilya/virtari-ui.git",
    "directory": "packages/react-yoopta-editor"
  },
  "bugs": {
    "url": "https://github.com/itstheilya/virtari-ui/issues"
  },
  "keywords": [
    "virtari",
    "design-system",
    "react",
    "ui",
    "editor",
    "yoopta",
    "rich-text",
    "block-editor"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": {
      "style": "./dist/YooptaEditor.css",
      "default": "./dist/YooptaEditor.css"
    },
    "./tokens": {
      "style": "./dist/YooptaEditor.tokens.css",
      "default": "./dist/YooptaEditor.tokens.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup && postcss src/YooptaEditor.tokens.css -o dist/YooptaEditor.tokens.css && postcss src/YooptaEditor.css -o dist/YooptaEditor.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yoopta/accordion": "^6.0.5",
    "@yoopta/blockquote": "^6.0.5",
    "@yoopta/callout": "^6.0.5",
    "@yoopta/carousel": "^6.0.5",
    "@yoopta/code": "^6.0.5",
    "@yoopta/divider": "^6.0.5",
    "@yoopta/editor": "^6.0.5",
    "@yoopta/embed": "^6.0.5",
    "@yoopta/emoji": "^6.0.5",
    "@yoopta/file": "^6.0.5",
    "@yoopta/headings": "^6.0.5",
    "@yoopta/image": "^6.0.5",
    "@yoopta/link": "^6.0.5",
    "@yoopta/lists": "^6.0.5",
    "@yoopta/marks": "^6.0.5",
    "@yoopta/math": "^6.0.5",
    "@yoopta/mention": "^6.0.5",
    "@yoopta/paragraph": "^6.0.5",
    "@yoopta/steps": "^6.0.5",
    "@yoopta/table": "^6.0.5",
    "@yoopta/table-of-contents": "^6.0.5",
    "@yoopta/tabs": "^6.0.5",
    "@yoopta/video": "^6.0.5",
    "@virtari-packages/react-accordion": "workspace:*",
    "@virtari-packages/react-button": "workspace:*",
    "@virtari-packages/react-dropdown-menu": "workspace:*",
    "@virtari-packages/react-file-upload": "workspace:*",
    "@virtari-packages/react-icons": "workspace:*",
    "@virtari-packages/react-input": "workspace:*",
    "@virtari-packages/react-popover": "workspace:*",
    "@virtari-packages/react-scroll-area": "workspace:*",
    "@virtari-packages/react-tabs": "workspace:*",
    "@virtari-packages/react-tooltip": "workspace:*",
    "@virtari-packages/utils": "workspace:*",
    "katex": "^0.18.7",
    "slate": "^0.126.2",
    "slate-dom": "^0.126.0",
    "slate-react": "^0.126.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
