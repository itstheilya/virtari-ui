{
  "name": "@virtari-packages/react-date-picker",
  "version": "1.1.1",
  "description": "Virtari date picker — accessible React component built on CSS variables and logical properties.",
  "license": "MIT",
  "author": "Virtari",
  "homepage": "https://github.com/itstheilya/virtari-ui/tree/main/packages/react-date-picker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itstheilya/virtari-ui.git",
    "directory": "packages/react-date-picker"
  },
  "bugs": {
    "url": "https://github.com/itstheilya/virtari-ui/issues"
  },
  "keywords": [
    "virtari",
    "design-system",
    "react",
    "ui",
    "components",
    "date",
    "picker"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": {
      "style": "./dist/DatePicker.css",
      "default": "./dist/DatePicker.css"
    },
    "./tokens": {
      "style": "./dist/DatePicker.tokens.css",
      "default": "./dist/DatePicker.tokens.css"
    },
    "./calendar/styles": {
      "style": "./dist/Calendar.css",
      "default": "./dist/Calendar.css"
    },
    "./calendar/tokens": {
      "style": "./dist/Calendar.tokens.css",
      "default": "./dist/Calendar.tokens.css"
    },
    "./date-field/styles": {
      "style": "./dist/DateField.css",
      "default": "./dist/DateField.css"
    },
    "./date-field/tokens": {
      "style": "./dist/DateField.tokens.css",
      "default": "./dist/DateField.tokens.css"
    },
    "./time-field/styles": {
      "style": "./dist/TimeField.css",
      "default": "./dist/TimeField.css"
    },
    "./time-field/tokens": {
      "style": "./dist/TimeField.tokens.css",
      "default": "./dist/TimeField.tokens.css"
    },
    "./range-picker/styles": {
      "style": "./dist/DateRangePicker.css",
      "default": "./dist/DateRangePicker.css"
    },
    "./range-picker/tokens": {
      "style": "./dist/DateRangePicker.tokens.css",
      "default": "./dist/DateRangePicker.tokens.css"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_LICENSES.txt",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup && postcss src/DatePicker.tokens.css -o dist/DatePicker.tokens.css && postcss src/DatePicker.css -o dist/DatePicker.css && postcss src/Calendar.tokens.css -o dist/Calendar.tokens.css && postcss src/Calendar.css -o dist/Calendar.css && postcss src/DateField.tokens.css -o dist/DateField.tokens.css && postcss src/DateField.css -o dist/DateField.css && postcss src/TimeField.tokens.css -o dist/TimeField.tokens.css && postcss src/TimeField.css -o dist/TimeField.css && postcss src/DateRangePicker.tokens.css -o dist/DateRangePicker.tokens.css && postcss src/DateRangePicker.css -o dist/DateRangePicker.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@internationalized/date": "^3.5.6",
    "@react-aria/calendar": "^3.5.14",
    "@react-aria/datepicker": "^3.11.5",
    "@react-aria/i18n": "^3.12.3",
    "@react-stately/calendar": "^3.5.5",
    "@react-stately/datepicker": "^3.10.3",
    "@virtari-packages/primitives": "workspace:*",
    "@virtari-packages/react-button": "workspace:*",
    "@virtari-packages/react-dialog": "workspace:*",
    "@virtari-packages/react-drawer": "workspace:*",
    "@virtari-packages/react-icons": "workspace:*",
    "@virtari-packages/react-radio-group": "workspace:*",
    "@virtari-packages/utils": "workspace:*"
  },
  "peerDependencies": {
    "@tabler/icons-react": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tabler/icons-react": "^3.0.0",
    "react": "^19.2.5",
    "@types/react": "^19.2.14",
    "typescript": "^5.5.0",
    "tsup": "^8.0.0"
  }
}
